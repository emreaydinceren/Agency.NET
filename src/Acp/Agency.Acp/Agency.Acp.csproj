<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Agent Client Protocol (ACP) host for the Agency AI Toolkit: exposes the agent harness over newline-delimited JSON-RPC 2.0 on stdio so any ACP client can drive an Agency agent.</Description>
    <PackageTags>agency.net;ai;agent;acp;jsonrpc;stdio;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Agency.Configuration\Agency.Configuration.csproj" />
    <ProjectReference Include="..\..\Harness\Agency.Harness\Agency.Harness.csproj" />
    <ProjectReference Include="..\..\Llm\Agency.Llm.Common\Agency.Llm.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotacp.protocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack="false": the file must reach the BUILD OUTPUT (that is what makes a vanilla
         agency-acp startable — PersonaIdentity spec §6.5, O-5), but it must not reach the
         NUPKG. Without this, NuGet emits content/ and contentFiles/ entries and copies this
         placeholder config into the build output of any downstream PackageReference
         consumer, colliding with their own appsettings.json. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
